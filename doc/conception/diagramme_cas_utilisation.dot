// Diagramme de cas d'utilisation de LaborScope (à jour avec les pages Streamlit)
// Générer l'image : dot -Tpng -Gdpi=200 doc/conception/diagramme_cas_utilisation.dot -o doc/images/diagramme_cas_utilisation.png
digraph cas_utilisation {
    rankdir=LR;
    newrank=true;
    nodesep=0.25; ranksep=1.1;
    node [fontname="Helvetica", fontsize=12];
    edge [arrowhead=none, color="#444444"];

    // Acteurs
    node [shape=none, image="doc/conception/acteur.png", imagepos=tc, labelloc=b, height=1.3];
    visiteur [label="\n\n\n\nVisiteur\n(non connecté)", fontsize=13];
    utilisateur [label="\n\n\n\nUtilisateur", fontsize=13];
    admin [label="\n\n\n\nAdministrateur", fontsize=13];

    // Héritage : l'administrateur peut faire tout ce que fait l'utilisateur
    admin -> utilisateur [arrowhead=onormal, arrowsize=1.4, style=solid, constraint=false];

    subgraph cluster_app {
        label="Application LaborScope"; fontname="Helvetica-Bold"; fontsize=14;
        style=rounded; color="#08306b"; penwidth=1.5;
        node [shape=ellipse, image="", labelloc=c, height=0.5, style=filled, fillcolor="#deebf7", color="#08306b", width=3.2];

        creer [label="Créer un compte"];
        connecter [label="Se connecter"];

        deconnecter [label="Se déconnecter"];
        explorer [label="Explorer les données"];
        f3 [label="Voir l'évolution\nd'un indicateur (F3)"];
        f4 [label="Comparer un indicateur\nentre pays (F4)"];
        fo2 [label="Visualiser un indicateur\nsur une carte (FO2)"];
        f5 [label="Comparer plusieurs\nindicateurs (F5)"];
        fo3 [label="Générer un rapport PDF (FO3)"];

        node [fillcolor="#c6dbef"];
        gerer_util [label="Gérer les comptes\n(ajouter, supprimer)"];
        gerer_donnees [label="Gérer les données\n(modifier, supprimer une observation)"];
        importer [label="Forcer l'import ILOSTAT"];
        historique [label="Consulter l'historique\ndes actions"];
        logs [label="Consulter les logs techniques"];
    }

    visiteur -> {creer connecter};
    utilisateur -> {deconnecter explorer f3 f4 fo2 f5 fo3};
    admin -> {gerer_util gerer_donnees importer historique logs};

    {rank=same; visiteur; utilisateur; admin;}
}
