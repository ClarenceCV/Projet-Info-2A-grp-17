# LaborScope configuration.
# Copy this file to `.env` (same folder, project root) and fill in the PostgreSQL values:
#     cp .env.example .env
# The `.env` file is ignored by git: never commit your password.

# --- PostgreSQL database -----------------------------------------------------------------
# On Onyxia, all these values are shown in the README of your PostgreSQL service.
# Hostname of the database, e.g. postgresql-123456 (on Onyxia) or localhost
POSTGRES_HOST=
# Usually 5432
POSTGRES_PORT=5432
# Database name, e.g. defaultdb on Onyxia
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Schema holding the LaborScope tables (created by utils/reset_database.py): keep this value
POSTGRES_SCHEMA=laborscope

# --- API (backend, FastAPI) --------------------------------------------------------------
# 0.0.0.0 makes the API reachable from outside the container (needed on Onyxia)
UVICORN_HOST=0.0.0.0
# Port of the API: must be one of the ports opened in your Onyxia service
UVICORN_PORT=5000

# --- Interface (frontend, Streamlit) -----------------------------------------------------
# Address the interface uses to call the API (same machine, so localhost works)
BACKEND_URL=http://localhost:5000
# Maximum waiting time for an API answer, in seconds (the full data import has its own, longer one)
BACKEND_TIMEOUT=10
